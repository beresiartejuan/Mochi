# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Ollama Cloud
OLLAMA_API_KEY=your_ollama_cloud_api_key
OLLAMA_HOST=https://ollama.com
CHAT_MODEL=gpt-oss:120b

# Personal authorized chat (your Telegram user ID as an integer)
