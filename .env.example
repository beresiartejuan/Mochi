# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Ollama Cloud
OLLAMA_API_KEY=your_ollama_cloud_api_key
OLLAMA_HOST=https://ollama.com # será convertido a https://api.ollama.com/api
CHAT_MODEL=gpt-oss:120b
# SUMMARY_MODEL=gpt-oss:20b

# Personal authorized chat (your Telegram user ID as an integer)
CHAT_ID=123456789

# Search tools (optional)
# SERP_API_KEY=your_serpapi_key
# TAVILY_API_KEY=your_tavily_key

# Polling behavior
POLLING_TIMEOUT=60
POLLING_RETRY_SECONDS=6

# Workspace sandbox for command execution
WORKSPACE_DIR=/home/beresiarte/code/me/mochi

# Persistent memory (SQLite file managed by Turso)
# MEMORY_DB_PATH=data/memory.db

# Inactivity guard (seconds)
# BOT_INACTIVITY_THRESHOLD_SECONDS=3600
